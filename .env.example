# local  = full pipeline (upload -> faster-whisper -> Ollama -> SQLite). Run this at home.
# viewer = read-only recipe book, no ML deps; used for the public Render deployment.
ECHOBOOK_MODE=local

# Speech-to-text (faster-whisper). small.en is a good CPU default; large-v3 on a GPU is best.
WHISPER_MODEL=small.en
WHISPER_DEVICE=auto
WHISPER_COMPUTE_TYPE=auto

# Local LLM via Ollama. qwen2.5:7b-instruct is the most faithful; qwen2.5:3b-instruct is ~2x faster on CPU.
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:7b-instruct
# OLLAMA_NUM_GPU=0          # force CPU (faster than a partial offload onto a small GPU)

# Personalisation
ECHOBOOK_STORYTELLER=Sharma Ji
ECHOBOOK_TITLE=Sharma Ji ki Rasoi
ECHOBOOK_COLLECTED_BY=Piyush Darshan & Ankit

# Once models are downloaded, force fully-offline operation:
# HF_HUB_OFFLINE=1

# Or run the LLM steps (structuring + both agents) on Gemma, Google's open-weight model, via the
# Gemini API. Free key: https://aistudio.google.com/apikey. Transcripts are then sent to Google.
# LLM_PROVIDER=gemma
# GEMINI_API_KEY=
# GEMMA_MODEL=gemma-4-26b-a4b-it   # or gemma-4-31b-it
# GEMMA_THINKING=minimal           # "high" = slower but more careful
