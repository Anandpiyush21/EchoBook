# local  = full pipeline (upload -> faster-whisper -> Ollama -> SQLite). Run this at home.
# viewer = read-only recipe book, no ML deps; used for the public Render deployment.
ECHOBOOK_MODE=local

# Speech-to-text (faster-whisper). small.en is a good CPU default; large-v3 on a GPU is best.
WHISPER_MODEL=small.en
WHISPER_DEVICE=auto
WHISPER_COMPUTE_TYPE=auto

# Local LLM via Ollama. qwen2.5:7b-instruct is the most faithful; qwen2.5:3b-instruct is ~2x faster on CPU.
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:7b-instruct
# OLLAMA_NUM_GPU=0          # force CPU (faster than a partial offload onto a small GPU)

# Personalisation
ECHOBOOK_STORYTELLER=Grandpa
ECHOBOOK_TITLE=Grandpa's Kitchen

# Once models are downloaded, force fully-offline operation:
# HF_HUB_OFFLINE=1
